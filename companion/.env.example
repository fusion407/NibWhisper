# Copy this file to .env. Keep keys private; never place one in the addon.
# Gemini needs a Google AI Studio key. Use a free-tier project for free quotas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: the same synced folder on desktop and laptop. Defaults to OneDrive/NibTrail when available.
# NIB_SYNC_DIR=C:\Users\YourName\OneDrive\NibTrail
# Optional alternative. Selecting Gemini never uses this key or paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# OpenAI-only: cited Wowhead/Blizzard search. Disabled in Gemini free mode.
OPENAI_SEARCH_MODEL=gpt-6.1-sol
NIB_PORT=17861
NIB_EVE_PORT=17862
# Optional screen-code transport; enable only after installing the optional
# reply modules and running /nib auto on in game. Reads only Nib's color region.
# NIB_OPTICAL_ADDONS=A:\World of Warcraft\_forever_\Interface\AddOns
