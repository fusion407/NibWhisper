{
  "name": "companion",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "node server.mjs",
    "dev:eve": "eve dev --no-ui --no-default-extensions --host 127.0.0.1 --port 17862",
    "eval": "eve eval",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.117",
    "@vercel/connect": "2.9.1",
    "ai": "^7.0.137",
    "eve": "^1.0.0-rc.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
